enclave {
    from "sgx_tstdc.edl" import *;

    trusted {
        public void ecall_run_pipeline(
            [out] uint64_t *dependent_time, 
            [out] uint64_t *independent_time
        );
        public void ecall_run_branch(
            [out] uint64_t *random_cycles, 
            [out] uint64_t *sorted_cycles
        );
    };

    untrusted {
        void ocall_print([in, string] const char *str);
    };
};
